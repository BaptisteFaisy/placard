# Lieneur aplati : les outils de développement déclarés à la racine
# (typescript, vitest, eslint, react…) sont visibles depuis chaque paquet.
# Choix assumé pour un monorepo de concours : une seule installation, un seul
# lockfile, zéro conflit de fusion sur pnpm-lock.yaml entre les lots.
node-linker=hoisted
strict-peer-dependencies=false
auto-install-peers=true
